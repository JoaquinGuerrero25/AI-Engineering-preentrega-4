# Copiá este archivo como .env y completá tus claves. El .env NUNCA se sube al repo.

# --- Pinecone (https://app.pinecone.io -> API Keys) ---
PINECONE_API_KEY=
INDEX_NAME=python-docs-rag
PINECONE_NAMESPACE=python-stdlib-es
# Serverless: aws/us-east-1 es la región disponible en el plan gratuito (Starter)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Embeddings: gemini (por defecto, plan gratuito) u openai ---
EMBEDDING_PROVIDER=gemini
# Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# OpenAI (sólo si EMBEDDING_PROVIDER=openai): text-embedding-3-small
OPENAI_API_KEY=

# Dimensión del índice y de los embeddings (deben coincidir)
EMBEDDING_DIMENSION=1536

# --- Opcionales (valores por defecto) ---
# EMBEDDING_MODEL=models/gemini-embedding-001   (openai: text-embedding-3-small)
# CHUNK_SIZE_TOKENS=600
# CHUNK_OVERLAP_TOKENS=90
# TOP_K=5
# CANDIDATES_PER_RETRIEVER=10
# BM25_WEIGHT=0.5
# VECTOR_WEIGHT=0.5
